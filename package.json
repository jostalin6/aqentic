{
    "name": "aqentic",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test:rules": "firebase emulators:exec --only firestore --project demo-aqentic \"node --test tests/firestore.test.mjs\"",
        "deploy": "npm run build && firebase deploy"
    },
    "dependencies": {
        "firebase": "^12.0.0",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "typescript": "^5.9.0",
        "vite": "^7.0.0"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.13.6"
    }
}
